# LLM configuration for the autonomous driver (copy to .env).
# The interactive /or-iterate skill uses whatever session it runs in;
# only scripts/run_loop.py needs these.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional per-tier overrides used by the headless sessions:
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Observability (optional): route Claude Code session traces to Langfuse.
# Present keys enable telemetry automatically in the autonomous driver;
# for interactive sessions launch via: scripts/with_langfuse.sh claude
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST: default https://cloud.langfuse.com; set for self-hosted,
# e.g. http://localhost:3300. NOTE: keep comments on their own line - the
# shell wrapper parses values literally, so an inline comment would corrupt
# the host URL.
# LANGFUSE_HOST=http://localhost:3300
